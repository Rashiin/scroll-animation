---
import Icon from './Icon.astro';
import { digits } from '../i18n.js';
const { t } = Astro.props;
const u = t.uses;
const L = t.lang;
const icons = ['home', 'tree', 'briefcase', 'building', 'helmet', 'cup'];
const hues = [24, 150, 200, 280, 45, 340];
---
<section class="uses" id="uses" data-uses>
  <div class="uses__pin" data-uses-pin>
    <div class="wrap uses__head">
      <div>
        <span class="kicker" data-reveal>{u.kicker}</span>
        <h2 class="h-lg" data-split>{u.title}</h2>
      </div>
      <p class="lead" data-reveal>{u.text}</p>
    </div>
    <div class="uses__viewport">
      <ol class="uses__track" data-uses-track>
        {u.items.map((it, i) => (
          <li class="uc card" style={`--h:${hues[i]}`}>
            <div class="uc__art" aria-hidden="true">
              <span class="uc__orb"></span>
              <Icon name={icons[i]} size={64} class="uc__icon" />
              <span class="uc__grid"></span>
            </div>
            <div class="uc__body">
              <span class="uc__tag latin">{String(i + 1).padStart(2, '0')} / {it.tag}</span>
              <h3>{it.title}</h3>
              <p>{it.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
    <div class="wrap uses__progress" aria-hidden="true"><span data-uses-progress></span></div>
  </div>
</section>

<style>
  .uses { position: relative; padding-block: clamp(88px, 10vw, 140px) 40px; }
  .uses__head { display: grid; gap: 18px; margin-bottom: clamp(32px, 4vw, 56px); }
  @media (min-width: 900px) { .uses__head { grid-template-columns: 1.3fr 1fr; align-items: end; gap: 48px; } }
  .uses__viewport { overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: none; padding-inline: var(--gutter); scroll-padding-inline: var(--gutter); }
  .uses__viewport::-webkit-scrollbar { display: none; }
  .uses__track { list-style: none; margin: 0; padding: 0; display: flex; gap: 16px; width: max-content; }
  .uc { width: min(82vw, 420px); scroll-snap-align: start; overflow: hidden; display: flex; flex-direction: column; }
  .uc__art { position: relative; height: 240px; display: grid; place-items: center; overflow: hidden; border-bottom: 1px solid var(--line); background: radial-gradient(80% 90% at 50% 100%, hsl(var(--h) 90% 55% / 0.28), transparent 70%); }
  .uc__orb { position: absolute; width: 180px; height: 180px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, hsl(var(--h) 100% 70% / 0.9), hsl(var(--h) 90% 45% / 0.2) 60%, transparent 70%); filter: blur(10px); transition: transform 1s var(--ease-out); }
  .uc__grid { position: absolute; inset: 0; background-image: linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px); background-size: 28px 28px; mask-image: radial-gradient(circle at 50% 60%, #000, transparent 75%); }
  .uc__art :global(.uc__icon) { position: relative; z-index: 1; color: #fff; stroke-width: 1.1; filter: drop-shadow(0 6px 20px hsl(var(--h) 90% 50% / 0.8)); transition: transform 1s var(--ease-out); }
  .uc:hover .uc__orb { transform: scale(1.25) translate(10px, -10px); }
  .uc:hover :global(.uc__icon) { transform: translateY(-6px) scale(1.06); }
  .uc__body { padding: 26px; display: grid; gap: 10px; }
  .uc__tag { font-size: 0.7rem; letter-spacing: 0.2em; color: hsl(var(--h) 90% 72%); }
  .uc h3 { font-size: 1.5rem; }
  .uc p { color: var(--muted); font-size: 0.95rem; }
  .uses__progress { margin-top: 28px; height: 2px; background: var(--line); border-radius: 2px; overflow: hidden; }
  .uses__progress span { display: block; height: 100%; width: 100%; background: var(--accent); transform: scaleX(0); transform-origin: 0 50%; }
  :global([dir='rtl']) .uses__progress span { transform-origin: 100% 50%; }

  /* Desktop: GSAP pins the section and scrubs the track horizontally. */
  :global(.uses-pinned) .uses__viewport { overflow: visible; scroll-snap-type: none; }
  :global(.uses-pinned) .uses__pin { min-height: 100vh; display: flex; flex-direction: column; justify-content: center; }
  :global(.uses-pinned) .uc { width: 400px; }
</style>
